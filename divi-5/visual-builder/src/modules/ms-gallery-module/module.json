{
  "name": "mgfd/ms-gallery-for-divi",
  "d4Shortcode": "mgfd_ms_gallery",
  "title": "MS Gallery",
  "titles": "MS Gallerys",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}"
    },
    "image_style": {
      "type": "object",
      "selector": "{{selector}} .mgfd-ms-gallery-masonry-item img"
    },
    "gallery_image_size": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "full"
        }
      }
    },
    "gallery_style": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "masonry"
        }
      }
    },
    "gallery_image_link": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "none"
        }
      }
    },
    "grid_column": {
      "type": "number",
      "default": {
        "desktop": {
          "value": 3
        }
      }
    },
    "overlay_content" : {
      "type": "object",
      "default": {
        "desktop": {
          "value": "on"
        }
      }
    },
    "overlay_color": {
      "type": "object",
      "default": {
        "desktop": {
          "value": {
            "decoration": {
              "backgroundColor": "#00000099"
            }
          }
        }
      }
    },
    "overlay_text_color": {
      "type": "object",
      "default": {
        "desktop": {
          "value": {
            "decoration": {
              "color": "#00000099"
            }
          }
        }
      }
    },
    "gallery_ids": {
      "type": "object",
      "default": {
        "desktop": {
          "value": []
        }
      }
    },
    "grid_row_gap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "10"
        }
      }
    },
    "grid_column_gap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "10"
        }
      }
    },
    "image_object_fit": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "cover"
        }
      }
    }
  }
}